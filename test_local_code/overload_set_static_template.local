# 1 "overload_set_static_template.cc"
namespace ns {

struct A {
  int v;
};
struct B {
  int v;
};


template <typename T>
void f(T &dst, const A &src) {
  dst.v = src.v;
}


static void f(A &dst, const B &src) {
  dst.v = src.v;
}

template <typename D, typename S>
void g(D *dst, const S *src) {
  f(dst[0], src[0]);
}

int use() {
  A a{};
  B b{1};
  g(&a, &b);
  return a.v;
}

}

int main() { return ns::use(); }
