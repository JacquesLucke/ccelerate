# 1 "using_decl_type.cc"
namespace A {
namespace B {

struct C {
  struct D {
    static constexpr int k = 1;
  };
  enum class E { F = 2 };
};

}
}

namespace N {
using namespace ::A;
using ::A::B::C;

int use() {


  ::A::B::C x;
  ::A::B::C::D d{};
  (void)x;
  return int(::A::B::C::E::F) + d.k;
}

}

int main() { return ::N::use(); }
