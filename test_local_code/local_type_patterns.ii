# 1 "local_type_patterns.cc"
namespace pattern_local_type {
struct OnlyLocalType__ {
  int x;
  OnlyLocalType__(int value) : x(value) {}
};

::pattern_local_type::OnlyLocalType__ make_value() { return ::pattern_local_type::OnlyLocalType__(7); }
}

int main() { return ::pattern_local_type::make_value().x; }
