# 1 "using_namespaces.cc"
namespace A {
namespace B {
int value = 1;
}
}

namespace C {
using namespace ::A::B;

int use_value() { return ::A::B::value; }
}

using namespace ::C;

namespace {
using namespace ::A;
}

namespace D {
namespace {
using namespace ::A;
}
}

int main() {
  using namespace ::A;
  return ::C::use_value();
}
