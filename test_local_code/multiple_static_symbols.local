# 2 "multiple_static_symbols.cc"

static int get_size__() { return 10; }

namespace hello {
static std::vector<int> v__;
static int result__;

static int compute__() {
  v__.resize(get_size__(), 2);
  int sum = 0;
  for (const int &i : v__) {
    sum += i;
  }
  result__ = sum;
}

}
