# 1 "overload_set_static_template.cc"
namespace ns {

struct A {
  int v;
};
struct B {
  int v;
};


template <typename T>
void f(T &dst, const ::ns::A &src) {
  dst.v = src.v;
}


static void f(::ns::A &dst, const ::ns::B &src) {
  dst.v = src.v;
}

template <typename D, typename S>
void g(D *dst, const S *src) {
  ::ns::f(dst[0], src[0]);
}

int use() {
  ::ns::A a{};
  ::ns::B b{1};
  ::ns::g(&a, &b);
  return a.v;
}

}

int main() { return ::ns::use(); }
