# 1 "nested_name_leading_type.cc"
namespace N {
namespace M {

struct A {
  struct B {
    static B &get() {
      static B data;
      return data;
    }
  };
  using C = B;
};

template <typename T> struct D {
  static int value() { return 0; }

  struct E {
    static E &get() {
      static E data;
      return data;
    }
  };
};

}

namespace Other {
struct A {};
}
}

namespace N {
using namespace M;

void use() {

  ::N::M::A::B &x = ::N::M::A::B::get();
  (void)x;


  ::N::M::A::C &y = ::N::M::A::C::get();
  (void)y;



  int v = ::N::M::D<int>::value();
  (void)v;



  ::N::M::D<int>::E &z = ::N::M::D<int>::E::get();
  (void)z;
}
}
